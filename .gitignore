# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Legacy plugin registrant (Flutter < 3.0); keep out of history if generated
.flutter-plugins

# Local secrets and signing material. Never commit these.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
key.properties
signing.properties

# Local data: telemetry databases, exports and crash artifacts.
# Voltly stores device history locally and must never publish it.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.telemetry-export
*.hprof
crash-*.txt

# Local editor configuration
.vscode/
